# ==============================================================================
# FOSS CTF FRONTEND CONFIGURATION (.env)
# ==============================================================================

# Backend API Base URL
# In local development: leave empty to use Vite's local dev server proxy (/api -> http://localhost:4000)
# In production on Vercel: set to the backend's deployment URL (e.g. https://<ctf-backend-placeholder>.vercel.app)
VITE_API_URL=https://<ctf-backend-placeholder>.vercel.app
