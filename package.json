{
  "name": "ctffoss-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@fossctf/shared",
    "build:server": "npm run db:generate --workspace=server && npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "db:generate": "npm run db:generate --workspace=server",
    "db:migrate:check": "npm run db:migrate:check --workspace=server",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=server",
    "db:push": "npm run db:push --workspace=server",
    "db:seed": "npm run db:seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
