{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "NODE_ENV=test tsx --test test/competition.test.ts test/oidc.test.ts test/reliability.test.ts test/devRoster.test.ts test/serverless.test.ts",
    "build": "tsc && npm run db:generate",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:check": "tsx src/scripts/validateMigrationIsolation.ts",
    "db:migrate:deploy": "tsx src/scripts/validateMigrationIsolation.ts && prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx src/scripts/seedDevRoster.ts"
  },

  "dependencies": {
    "@fossctf/shared": "*",
    "@prisma/client": "^6.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "openid-client": "^6.8.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
