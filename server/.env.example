# Server Environment Configuration
PORT=4001
NODE_ENV=development

# Development Authentication Switch (MUST BE FALSE IN PRODUCTION)
ENABLE_DEV_AUTH=true

# Security Secrets (Replace with cryptographically random strings in production)
JWT_SECRET=foss-ctf-super-secure-dev-jwt-secret-key-replace-in-prod-32c
FLAG_PEPPER=foss-ctf-flag-pepper-secret-dev-replace-in-prod

# Database Connection (Supabase PostgreSQL or local PostgreSQL)
# Example for Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fossctf?schema=public

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173
