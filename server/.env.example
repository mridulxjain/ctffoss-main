# ==============================================================================
# FOSS CTF BACKEND CONFIGURATION (.env)
# ==============================================================================

# Server Runtime
PORT=4000
NODE_ENV=development

# Development Authentication Switch (CRITICAL: MUST BE FALSE IN PRODUCTION)
ENABLE_DEV_AUTH=false

# Security Secrets (Must be random high-entropy strings, min 32 chars in production)
JWT_SECRET=foss-ctf-super-secure-dev-jwt-secret-key-replace-in-prod-32c
FLAG_PEPPER=foss-ctf-flag-pepper-secret-dev-replace-in-prod

# Database Connection (Supabase PostgreSQL with schema isolation)
# Both CTF and Loventia share the same Supabase project.
# CTF tables reside exclusively in schema=ctf.
#
# Supabase Runtime Queries (Connection Pooler via pgBouncer/Supavisor, port 6543):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20&schema=ctf"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fossctf?schema=ctf"

# Supabase Prisma Migrations (Direct Connection, port 5432 - run separately from app startup):
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?schema=ctf"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fossctf?schema=ctf"

# Cross-Origin Frontend & CORS Configuration
# In production, CTF frontend is at https://ctf.fossclub.tech
FRONTEND_URL=https://ctf.fossclub.tech
CORS_ORIGINS="https://ctf.fossclub.tech"

# Cross-Origin Cookie Policy
# In cross-origin deployments (frontend on ctf.fossclub.tech, backend on *.vercel.app),
# cookies must use 'none' (with secure: true). Defaults to 'none' in production.
COOKIE_SAME_SITE=none

# Reverse Proxy Trust (Set to 1 or true when running behind Vercel)
TRUST_PROXY=1

# OpenID Connect Configuration (USAR FOSS OIDC)
OIDC_ISSUER=https://oidc.fossclub.tech
OIDC_CLIENT_ID=ctf
OIDC_CLIENT_SECRET=your-oidc-client-secret-here
# OIDC callback must point to the backend's Vercel deployment URL:
OIDC_REDIRECT_URI=https://<ctf-backend-placeholder>.vercel.app/api/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://ctf.fossclub.tech
OIDC_SCOPES="openid profile email club"
